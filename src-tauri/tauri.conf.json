{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitwise",
  "version": "0.1.0",
  "identifier": "io.github.tamirgabgab.bitwise",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -- --mode desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bitwise",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A digital logic simulator",
    "longDescription": "Build a circuit from gates and watch it run as you wire it, at radix 2 or any radix up to 16.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["bitwise"],
        "name": "Bitwise project",
        "description": "A Bitwise project",
        "mimeType": "application/x-bitwise",
        "role": "Editor"
      }
    ]
  }
}
